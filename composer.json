{
    "name": "rephper/rephper",
    "description": "Inspect compiled PHP opcodes, export versioned IR JSON, build control-flow graphs, and reconstruct expressions inside a basic block.",
    "type": "project",
    "require": {
        "php": "^8.4",
        "symfony/console": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "Rephper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rephper\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/rephper"
    ],
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
